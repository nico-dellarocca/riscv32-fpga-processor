// Tang Nano 20K board pin mapping from the original FPGA starter.
// Clock + LED0 were used in the earlier FPGA blink build. Verify S1 pin 88.
IO_LOC "clk_27mhz" 4;
IO_PORT "clk_27mhz" IO_TYPE=LVCMOS33;
IO_LOC "led_n" 15;
IO_PORT "led_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "button_n" 88;
IO_PORT "button_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
